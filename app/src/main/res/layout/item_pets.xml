<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:rippleColor="@color/ripple_color"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Pet Photo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_pet_profile_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
            android:contentDescription="Pet image" />

        <!-- Name & Species -->
        <TextView
            android:id="@+id/tv_pet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/heading_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_pending_tasks_count"
            app:layout_constraintStart_toEndOf="@id/iv_pet_profile_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Lussi" />

        <TextView
            android:id="@+id/tv_breed_species_combined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/second_text"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_pet_name"
            app:layout_constraintTop_toBottomOf="@id/tv_pet_name"
            tools:text="Street • Dog" />

        <!-- Diet Badge -->
        <TextView
            android:id="@+id/tv_pet_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_chip"
            android:backgroundTint="#E0F2F1"
            android:drawableStart="@drawable/outline_accessible_menu_24"
            android:drawablePadding="6dp"
            android:drawableTint="@color/Button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/Button"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_pet_name"
            app:layout_constraintTop_toBottomOf="@id/tv_breed_species_combined"
            tools:text="Diet: Chicken" />

        <!-- Stats row at the bottom -->
        <LinearLayout
            android:id="@+id/ll_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_pet_profile_icon">

            <TextView
                android:id="@+id/tv_pet_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_chip"
                android:textColor="@color/second_text"
                android:textSize="12sp"
                tools:text="1 yrs old" />

            <TextView
                android:id="@+id/tv_pet_weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_chip"
                android:textColor="@color/second_text"
                android:textSize="12sp"
                tools:text="22.0 kg" />

        </LinearLayout>

        <!-- Task Badge (Top Right) -->
        <TextView
            android:id="@+id/tv_pending_tasks_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_chip"
            android:backgroundTint="#FFF5F5"
            android:text="1 task"
            android:textColor="@color/error_color"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1 task" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>